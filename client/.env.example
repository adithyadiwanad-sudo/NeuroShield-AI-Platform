# Copy to .env.local for local development. Never put secrets in public variables.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live-feed
# VITE_API_URL / VITE_WS_URL aliases are also supported and take precedence.
# Cloud: set the API to your real https://<service>.onrender.com origin and
# WebSocket to wss://<service>.onrender.com/ws/live-feed in Vercel, then rebuild.
# Optional existing Express tools (separate service):
# VITE_LEGACY_API_URL=https://<express-service>/api
